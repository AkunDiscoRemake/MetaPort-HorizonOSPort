# Adapt the public Quest kernel to QEMU virt; do not replace Horizon userspace.
CONFIG_LOCALVERSION="-metaport-guest"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HVC_DRIVER=y
CONFIG_HVC_IRQ=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_LZ4=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_SECURITY_SELINUX=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_EXT4_FS=y
CONFIG_F2FS_FS=y
CONFIG_TMPFS=y
CONFIG_BOOT_CONFIG=y
# Build-only adaptations for the pinned distro LLVM toolchain.
# CONFIG_LTO_CLANG is not set
# CONFIG_LTO_CLANG_THIN is not set
CONFIG_LTO_NONE=y
# CONFIG_CFI_CLANG is not set
# CONFIG_SHADOW_CALL_STACK is not set
# CONFIG_DEBUG_INFO_BTF is not set
CONFIG_SYSTEM_TRUSTED_KEYS=""
# CONFIG_WERROR is not set
# CONFIG_LTO_CLANG_FULL is not set
# CONFIG_CMDLINE_FORCE is not set

# Optional, isolated diagnostic trace instance via appended bootconfig.
CONFIG_FTRACE=y
CONFIG_TRACING=y
CONFIG_EVENT_TRACING=y
CONFIG_BOOTTIME_TRACING=y
